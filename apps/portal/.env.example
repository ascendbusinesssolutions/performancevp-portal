# Environment variable register for the portal application.
#
# Copy this file to apps/portal/.env.local for local development. Never commit a file with
# values. Vercel holds the staging and production values; the milestone that first needs each
# variable is the milestone at which it is added there, and not before.
#
# Exposure: "browser" variables carry the NEXT_PUBLIC_ prefix and are bundled into the client.
# Everything else is server-only and must never gain that prefix.

# --- Milestone 0 ---------------------------------------------------------------
# Which environment this deployment is: local, staging or production. Read by the
# application in place of any hosting platform's own environment name.
APP_ENV=local

# --- Milestone 3: tenancy, roles and directory ---------------------------------
# Absolute base URL of this deployment, for links in email and auth redirects. Server-only.
# APP_BASE_URL=http://localhost:3000
# Supabase project URL and the public key (RLS enforced). Browser.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: ingestion and provisioning routes only. Server-only. Never in the browser.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Milestone 5: campaign engine ----------------------------------------------
# Secret for hashing single-use survey tokens. Server-only.
# SURVEY_TOKEN_SECRET=
# Resend API key for survey invitations, reminders and notifications. Server-only.
# Auth email is configured as custom SMTP inside Supabase at Milestone 3, not here.
# RESEND_API_KEY=

# --- Milestone 9: plans and billing --------------------------------------------
# STRIPE_SECRET_KEY=                       server-only
# STRIPE_WEBHOOK_SECRET=                   server-only
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=      browser
